{
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:receipts:schema:v1:common#/$defs/SchemaVersion"
    },
    "set_id": {
      "$ref": "urn:receipts:schema:v1:common#/$defs/EvalSetId"
    },
    "set_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Bump whenever labels or streams change. Published numbers always name the set_version."
    },
    "labels_file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,200}$",
      "description": "JSONL of eval labels, relative to this manifest."
    },
    "labels_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "label_count": {
      "type": "integer",
      "minimum": 1
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "match_id": {
            "$ref": "urn:receipts:schema:v1:common#/$defs/MatchId"
          },
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]{1,200}$",
            "description": "Event stream JSONL, relative to this manifest."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "event_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "match_id",
          "file",
          "sha256",
          "event_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "set_id",
    "set_version",
    "labels_file",
    "labels_sha256",
    "label_count",
    "streams"
  ],
  "additionalProperties": false,
  "description": "Pins an eval set to exact bytes so a published Verifier number can be reproduced.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receipts:schema:v1:eval-manifest",
  "title": "Eval set manifest (v1)"
}
